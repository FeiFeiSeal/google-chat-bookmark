{
  "manifest_version": 3,
  "name": "Google Chat Bookmark",
  "description": "在 Gmail Chat 收藏並快速返回重要討論。",
  "version": "0.1.2",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://chat.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "開啟 Google Chat Bookmark",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content-script.js"
      ]
    }
  ]
}
