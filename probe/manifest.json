{
  "manifest_version": 3,
  "name": "Chat Bookmark — 核心驗證",
  "version": "0.0.1",
  "description": "僅驗證右鍵選中 Gmail Chat 訊息與精確跳轉；不讀取完整聊天紀錄。",
  "minimum_chrome_version": "120",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "查看 Chat Bookmark 驗證結果", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://chat.google.com/*"],
    "all_frames": true,
    "run_at": "document_start",
    "js": ["core.js", "content.js"]
  }]
}
